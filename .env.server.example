# Copy this file on the server and fill real secrets:
#   cp .env.server.example .env.server
# Then run:
#   docker compose --env-file .env.server -f docker-compose.server.yml up -d --build

# --- PostgreSQL ---
POSTGRES_DB=telemakc
POSTGRES_USER=telemakc
POSTGRES_PASSWORD=replace-with-strong-db-password

# --- Backend security ---
SECRET_KEY=replace-with-long-random-secret-at-least-32-chars
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-strong-admin-password-at-least-12

# --- Domain / host policy ---
CORS_ORIGINS=https://tele-makc.ru,https://www.tele-makc.ru
# Публичные домены. localhost/127.0.0.1 к списку добавляются в коде (для Docker healthcheck).
TRUSTED_HOSTS=tele-makc.ru,www.tele-makc.ru

# --- URLs used by app ---
FRONTEND_BASE_URL=https://tele-makc.ru
NEXT_PUBLIC_SITE_URL=https://tele-makc.ru

# --- Mail (обязательно для уведомлений о заказах и форме контактов) ---
# Пример для Яндекс: SMTP_HOST=smtp.yandex.ru SMTP_PORT=465
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=orders@example.com
SMTP_PASSWORD=replace-with-app-password-from-yandex-mail
SMTP_FROM=orders@example.com
ORDER_NOTIFY_TO=manager@example.com
